    {
      "name": "04 - Registrar pedro",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/registro",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "usuario",
              "value": "pedro",
              "type": "text"
            },
            {
              "key": "clave",
              "value": "PedroLuis2026!",
              "type": "text"
            },
            {
              "key": "confirmacion",
              "value": "PedroLuis2026!",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201 o 409\", () => pm.expect(pm.response.code).to.be.oneOf([201,409]));",
              "pm.test(\"Respuesta JSON y contrato\", () => {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "  const data = pm.response.json();",
              "  pm.expect(data.codigo).to.be.oneOf([\"USUARIO_CREADO\",\"USUARIO_DUPLICADO\"]);",
              "  pm.expect(data.ok).to.eql(pm.response.code < 300);",
              "  pm.expect(data.mensaje).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(data).not.to.have.property(\"clave\");",
              "  pm.expect(data).not.to.have.property(\"hash\");",
              "  pm.expect(data.codigo).to.eql(pm.response.code === 201 ? \"USUARIO_CREADO\" : \"USUARIO_DUPLICADO\");",
              "});"
            ]
          }
        }
      ]
    },
